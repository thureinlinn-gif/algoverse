      "All parameters frozen ✓\n"
     ]
    }
   ],
   "source": [
    "DINOV2_REPO = os.path.join(PATHS['repos'], 'dinov2')\n",
    "if DINOV2_REPO not in sys.path:\n",
    "    sys.path.insert(0, DINOV2_REPO)\n",
    "\n",
    "from dinov2.hub.dinotxt import dinov2_vitl14_reg4_dinotxt_tet1280d20h24l, get_tokenizer\n",
    "\n",
    "print(\"Loading DinoTXT...\")\n",
    "dinotxt   = dinov2_vitl14_reg4_dinotxt_tet1280d20h24l().to(DEVICE)\n",
    "tokenizer = get_tokenizer()\n",
    "dinotxt.eval()\n",
    "\n",
    "for p in dinotxt.parameters():\n",
    "    p.requires_grad = False\n",
    "\n",
    "total     = sum(p.numel() for p in dinotxt.parameters())\n",
    "trainable = sum(p.numel() for p in dinotxt.parameters() if p.requires_grad)\n",
    "print(f\"Model loaded: {total/1e6:.1f}M parameters, {trainable} trainable (must be 0)\")\n",
    "assert trainable == 0, \"Model must be fully frozen\"\n",
    "print(\"All parameters frozen ✓\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Precompute verb text embeddings\n",
    "\n",
    "We encode each verb once per unique caption context.\n",
    "For each segment, we fill `[MASK]` with every verb in the vocabulary\n",
    "using that segment's actual masked caption — e.g.:\n",
    "  `'[MASK] the onions into small pieces'`\n",
    "becomes:\n",
    "  `['chop the onions into small pieces', 'stir the onions ...', ...]`\n",
    "\n",
    "This uses the real caption context rather than a generic template,\n",
    "which gives the text tower more signal to work with."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
