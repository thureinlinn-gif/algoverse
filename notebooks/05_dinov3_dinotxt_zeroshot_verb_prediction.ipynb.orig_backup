   "source": [
    "import json, pandas as pd\n",
    "\n",
    "with open('/home/ubuntu/youcook2-videos/processed/common_video_ids.json') as f:\n",
    "    common = json.load(f)\n",
    "common_segment_ids = set(common['segment_ids'])\n",
    "\n",
    "# results_df is the DINOv3 evaluation already run in this notebook\n",
    "dinov3_common = results_df[results_df['segment_id'].isin(common_segment_ids)]\n",
    "\n",
    "top1 = dinov3_common['top1_correct'].mean()\n",
    "top5 = dinov3_common['top5_correct'].mean()\n",
    "\n",
    "print(f\"=== DINOv3 + DinoTXT ===\")\n",
    "print(f\"  Segments evaluated : {len(dinov3_common):,}\")\n",
    "print(f\"  Val Top-1          : {top1:.4f}  ({top1*100:.2f}%)\")\n",
