   ],
   "source": [
    "import json\n",
    "import pandas as pd\n",
    "from collections import Counter\n",
    "\n",
    "CKPT_PATH = \"results_checkpoint.jsonl\"\n",
    "\n",
    "# ── Load ─────────────────────────────────────────────────────────────\n",
    "results = []\n",
    "with open(CKPT_PATH) as f:\n",
    "    for line in f:\n",
    "        line = line.strip()\n",
    "        if line:\n",
    "            results.append(json.loads(line))\n",
    "\n",
    "df = pd.DataFrame(results)\n",
    "total = len(df)\n",
    "\n",
    "# ── Overall ──────────────────────────────────────────────────────────\n",
    "top1 = df['top1_correct'].mean() * 100\n",
    "top5 = df['top5_correct'].mean() * 100\n",
    "\n",
    "print(\"=\" * 50)\n",
    "print(f\"  DinoTXT Zero-Shot — Preliminary Results\")\n",
    "print(\"=\" * 50)\n",
    "print(f\"  Segments evaluated : {total:,}\")\n",
    "print(f\"  Top-1 Accuracy     : {top1:.2f}%\")\n",
    "print(f\"  Top-5 Accuracy     : {top5:.2f}%\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# ── Per split ────────────────────────────────────────────────────────\n",
    "print(\"\\nBreakdown by split:\")\n",
    "for subset, grp in df.groupby('subset'):\n",
    "    t1 = grp['top1_correct'].mean() * 100\n",
    "    t5 = grp['top5_correct'].mean() * 100\n",
    "    print(f\"  {subset:<12}  Top-1: {t1:.2f}%   Top-5: {t5:.2f}%   (n={len(grp):,})\")\n",
    "\n",
    "# ── Majority class baseline ──────────────────────────────────────────\n",
    "most_common_verb = df['ground_truth'].value_counts().index[0]\n",
    "baseline = (df['ground_truth'] == most_common_verb).mean() * 100\n",
    "print(f\"\\n  Majority-class baseline (always predict '{most_common_verb}'): {baseline:.2f}%\")\n",
    "\n",
    "# ── Most common ground truth verbs + their accuracy ──────────────────\n",
    "print(\"\\nTop-10 most frequent verbs:\")\n",
    "print(f\"  {'Verb':<15} {'Count':>6}  {'Top-1':>7}  {'Top-5':>7}\")\n",
    "print(f\"  {'-'*15} {'-'*6}  {'-'*7}  {'-'*7}\")\n",
    "for verb, count in df['ground_truth'].value_counts().head(10).items():\n",
    "    sub = df[df['ground_truth'] == verb]\n",
    "    t1 = sub['top1_correct'].mean() * 100\n",
    "    t5 = sub['top5_correct'].mean() * 100\n",
    "    print(f\"  {verb:<15} {count:>6}  {t1:>6.1f}%  {t5:>6.1f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "results_df = pd.DataFrame(results)\n",
    "\n",
    "# Overall accuracy\n",
    "top1_overall = results_df['top1_correct'].mean()\n",
    "top5_overall = results_df['top5_correct'].mean()\n",
    "print(f\"Overall Top-1 : {top1_overall:.4f}  ({top1_overall*100:.2f}%)\")\n",
    "print(f\"Overall Top-5 : {top5_overall:.4f}  ({top5_overall*100:.2f}%)\")\n",
    "\n",
    "# Split by subset\n",
    "print()\n",
    "for subset in ['training', 'validation']:\n",
    "    sub = results_df[results_df['subset'] == subset]\n",
    "    if len(sub) == 0:\n",
    "        continue\n",
    "    t1 = sub['top1_correct'].mean()\n",
    "    t5 = sub['top5_correct'].mean()\n",
    "    print(f\"{subset:12s} — Top-1: {t1:.4f} ({t1*100:.2f}%)  Top-5: {t5:.4f} ({t5*100:.2f}%)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Per-verb accuracy breakdown"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "per_verb = results_df.groupby('ground_truth').agg(\n",
    "    count      = ('top1_correct', 'count'),\n",
    "    top1_acc   = ('top1_correct', 'mean'),\n",
    "    top5_acc   = ('top5_correct', 'mean'),\n",
    ").sort_values('count', ascending=False)\n",
    "\n",
    "print(\"Top 20 most frequent verbs:\")\n",
    "print(per_verb.head(20).to_string())"
   ]
  },
  {
