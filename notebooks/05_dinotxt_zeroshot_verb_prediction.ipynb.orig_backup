      "Total segments : 13,003\n",
      "Verb classes   : 282\n",
      "Columns        : ['caption', 'video_id', 'segment_id', 'extracted_verb', 'masked_caption', 'start_sec', 'end_sec', 'subset']\n",
      "                             caption     video_id       segment_id  \\\n",
      "0          crush and chop the garlic  --bv0V6ZjWI  --bv0V6ZjWI_000   \n",
      "1  add oil garlic and salt to a bowl  --bv0V6ZjWI  --bv0V6ZjWI_001   \n",
      "\n",
      "  extracted_verb                        masked_caption  start_sec  end_sec  \\\n",
      "0          crush            [MASK] and chop the garlic        8.0     23.0   \n",
      "1            add  [MASK] oil garlic and salt to a bowl       23.0     47.0   \n",
      "\n",
      "     subset  \n",
      "0  training  \n",
      "1  training  \n"
     ]
    }
   ],
   "source": [
    "df = pd.read_csv('/home/ubuntu/youcook2-videos/annotations/segments_verbs_timed_clean.csv')\n",
    "# Build verb vocabulary from all extracted verbs\n",
    "verb_vocab = sorted(df['extracted_verb'].unique().tolist())\n",
    "n_verbs    = len(verb_vocab)\n",
    "\n",
    "print(f\"Total segments : {len(df):,}\")\n",
    "print(f\"Verb classes   : {n_verbs}\")\n",
    "print(f\"Columns        : {df.columns.tolist()}\")\n",
    "print(df.head(2))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load DinoTXT model (frozen)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
