  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "1a532c8c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ DINOv2 DinoTXT loaded with V-JEPA2 projection\n",
      "  Projection shape: torch.Size([1024, 1280])\n",
      "Segments to evaluate: 134\n"
     ]
    },
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "a2a85fda33a44ce1a790fedc160f1b0c",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "V-JEPA2 + DinoTXT:   0%|          | 0/134 [00:00<?, ?it/s]"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "=== V-JEPA2 + DinoTXT ===\n",
      "  Segments evaluated : 134\n",
      "  Missing embeddings : 0\n",
      "  Val Top-1          : 0.3881  (38.81%)\n",
      "  Val Top-5          : 0.6493  (64.93%)\n"
     ]
    }
   ],
   "source": [
    "import json, os, torch\n",
    "import pandas as pd\n",
    "import torch.nn.functional as F\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "# ── Load common segment ids ────────────────────────────────────────────────────\n",
    "with open('/home/ubuntu/youcook2-videos/processed/common_video_ids.json') as f:\n",
    "    common = json.load(f)\n",
    "common_segment_ids = set(common['segment_ids'])\n",
    "\n",
    "# ── Load DINOv2 DinoTXT with V-JEPA2 projection ───────────────────────────────\n",
    "import sys\n",
    "DINOV2_REPO = '/home/ubuntu/youcook2-videos/repos/dinov2'\n",
    "if DINOV2_REPO not in sys.path:\n",
    "    sys.path.insert(0, DINOV2_REPO)\n",
    "\n",
    "from dinov2.hub.dinotxt import dinov2_vitl14_reg4_dinotxt_tet1280d20h24l, get_tokenizer\n",
    "import torch.nn as nn\n",
    "\n",
    "dinotxt_vj = dinov2_vitl14_reg4_dinotxt_tet1280d20h24l().to(DEVICE).eval()\n",
    "tokenizer_vj = get_tokenizer()\n",
    "dinotxt_vj = dinotxt_vj.to(DEVICE).eval()\n",
    "\n",
    "# Replace projection with V-JEPA2-compatible shape\n",
    "dinotxt_vj.text_model.head.linear_projection = nn.Linear(1280, 1024, bias=False).to(DEVICE)\n",
    "\n",
    "# Load trained V-JEPA2 projection weights\n",
    "CKPT_DIR = '/home/ubuntu/youcook2-videos/checkpoints'\n",
    "ckpt = torch.load(\n",
    "    os.path.join(CKPT_DIR, 'vjepa2_dinotxt_v2_cont_epoch5.pt'),\n",
    "    map_location=DEVICE\n",
    ")\n",
    "dinotxt_vj.text_model.head.linear_projection.load_state_dict(ckpt)\n",
    "\n",
    "for param in dinotxt_vj.parameters():\n",
    "    param.requires_grad = False\n",
    "dinotxt_vj.eval()\n",
    "\n",
    "print(f\"✓ DINOv2 DinoTXT loaded with V-JEPA2 projection\")\n",
    "print(f\"  Projection shape: {dinotxt_vj.text_model.head.linear_projection.weight.shape}\")\n",
    "\n",
    "# ── Load data ─────────────────────────────────────────────────────────────────\n",
    "with open('/home/ubuntu/youcook2-videos/paths.json') as f:\n",
    "    PATHS = json.load(f)\n",
    "\n",
    "df_all  = pd.read_csv('/home/ubuntu/youcook2-videos/annotations/segments_verbs_timed.csv')\n",
    "df_val  = df_all[df_all['subset'] == 'validation'].reset_index(drop=True)\n",
    "df_eval = df_val[df_val['segment_id'].isin(common_segment_ids)].reset_index(drop=True)\n",
    "\n",
    "verb_vocab = sorted(df_all['extracted_verb'].unique())\n",
    "label2id   = {v: i for i, v in enumerate(verb_vocab)}\n",
    "\n",
    "VJEPA2_EMB_DIR = os.path.join(PATHS['embeddings'], 'vjepa2_dinotxt')\n",
    "\n",
    "print(f\"Segments to evaluate: {len(df_eval):,}\")\n",
    "\n",
    "# ── Pre-tokenize bare verbs ────────────────────────────────────────────────────\n",
    "verb_tokens = tokenizer_vj.tokenize(verb_vocab).to(DEVICE)\n",
    "\n",
    "# ── Evaluation ────────────────────────────────────────────────────────────────\n",
    "vjepa2_results = []\n",
    "missing = 0\n",
    "\n",
    "dinotxt_vj.eval()\n",
    "with torch.no_grad():\n",
    "    # pre-compute verb embeddings once\n",
    "    verb_embs = dinotxt_vj.encode_text(verb_tokens, normalize=True)  # (282, 1024)\n",
    "\n",
    "    for _, row in tqdm(df_eval.iterrows(), total=len(df_eval), desc=\"V-JEPA2 + DinoTXT\"):\n",
    "        emb_path = os.path.join(VJEPA2_EMB_DIR, f\"{row['segment_id']}.pt\")\n",
    "        if not os.path.exists(emb_path):\n",
    "            missing += 1\n",
    "            continue\n",
    "\n",
    "        video_emb = torch.load(emb_path, map_location=DEVICE)\n",
    "        video_emb = F.normalize(video_emb.unsqueeze(0), dim=-1)\n",
    "\n",
    "        sim          = (dinotxt_vj.logit_scale.exp() * video_emb @ verb_embs.T).squeeze(0)\n",
    "        top5_indices = sim.topk(5).indices.tolist()\n",
    "        top1_verb    = verb_vocab[top5_indices[0]]\n",
    "        gt_verb      = row['extracted_verb']\n",
    "        gt_idx       = label2id.get(gt_verb, -1)\n",
    "\n",
    "        vjepa2_results.append({\n",
    "            'segment_id'  : row['segment_id'],\n",
    "            'ground_truth': gt_verb,\n",
    "            'top1_pred'   : top1_verb,\n",
    "            'top1_correct': top1_verb == gt_verb,\n",
    "            'top5_correct': gt_idx in top5_indices,\n",
    "        })\n",
    "\n",
    "vjepa2_common = pd.DataFrame(vjepa2_results)\n",
    "top1 = vjepa2_common['top1_correct'].mean()\n",
    "top5 = vjepa2_common['top5_correct'].mean()\n",
    "\n",
    "print(f\"\\n=== V-JEPA2 + DinoTXT ===\")\n",
    "print(f\"  Segments evaluated : {len(vjepa2_common):,}\")\n",
    "print(f\"  Missing embeddings : {missing:,}\")\n",
    "print(f\"  Val Top-1          : {top1:.4f}  ({top1*100:.2f}%)\")\n",
    "print(f\"  Val Top-5          : {top5:.4f}  ({top5*100:.2f}%)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "comparison",
   "metadata": {},
