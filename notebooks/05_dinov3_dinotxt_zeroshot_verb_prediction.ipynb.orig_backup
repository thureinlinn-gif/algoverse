   "source": [
    "import json\n",
    "import pandas as pd\n",
    "\n",
    "CKPT_PATH = '/home/ubuntu/youcook2-videos/notebooks/results_checkpoint.jsonl'\n",
    "\n",
    "# Load DINOv2 results\n",
    "dinov2_results = []\n",
    "with open(CKPT_PATH) as f:\n",
    "    for line in f:\n",
    "        line = line.strip()\n",
    "        if line:\n",
    "            dinov2_results.append(json.loads(line))\n",
    "\n",
    "dinov2_df = pd.DataFrame(dinov2_results)\n",
    "print(f\"DINOv2 total segments processed : {len(dinov2_df):,}\")\n",
    "print(f\"DINOv3 total segments processed : {len(results_df):,}\")\n",
    "\n",
    "# Find common segment_ids\n",
    "common_ids = set(dinov2_df['segment_id']) & set(results_df['segment_id'])\n",
    "print(f\"Common segments                 : {len(common_ids):,}\")\n",
    "\n",
    "# Filter to common segments only\n",
    "dinov2_common = dinov2_df[dinov2_df['segment_id'].isin(common_ids)].set_index('segment_id')\n",
    "dinov3_common = results_df[results_df['segment_id'].isin(common_ids)].set_index('segment_id')\n",
    "\n",
    "print(f\"\\n=== Comparison on {len(common_ids):,} shared segments ===\\n\")\n",
    "print(f\"{'Model':<22} {'Top-1':>10} {'Top-5':>10} {'N':>6}\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "for subset in ['training', 'validation']:\n",
    "    sub_v2 = dinov2_common[dinov2_common['subset'] == subset] if 'subset' in dinov2_common.columns else dinov2_common\n",
    "    sub_v3 = dinov3_common[dinov3_common['subset'] == subset] if 'subset' in dinov3_common.columns else dinov3_common\n",
    "\n",
    "    if len(sub_v2) > 0 or len(sub_v3) > 0:\n",
    "        print(f\"\\n  Subset: {subset}\")\n",
    "        print(\"-\" * 55)\n",
    "    if len(sub_v2) > 0:\n",
    "        t1 = sub_v2['top1_correct'].mean()\n",
    "        t5 = sub_v2['top5_correct'].mean()\n",
    "        print(f\"  {'DINOv2 + DinoTXT':<20} {t1*100:>9.2f}% {t5*100:>9.2f}%  {len(sub_v2):>5}\")\n",
    "    if len(sub_v3) > 0:\n",
    "        t1 = sub_v3['top1_correct'].mean()\n",
    "        t5 = sub_v3['top5_correct'].mean()\n",
    "        print(f\"  {'DINOv3 + DinoTXT':<20} {t1*100:>9.2f}% {t5*100:>9.2f}%  {len(sub_v3):>5}\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 55)\n",
    "print(f\"  Random baseline : {100/len(verb_vocab):.2f}%\")\n",
    "print(\"=\" * 55)"
   ]
  },
