    "    PATHS.get('outputs', ''),\n",
    "]\n",
    "\n",
    "print(\"=== Searching for results_checkpoint.jsonl ===\")\n",
    "for base in search_paths:\n",
    "    if not base:\n",
    "        continue\n",
    "    for root, dirs, files in os.walk(base):\n",
    "        for f in files:\n",
    "            if 'checkpoint' in f.lower() or 'results' in f.lower():\n",
    "                full = os.path.join(root, f)\n",
    "                size = os.path.getsize(full) / 1e6\n",
    "                print(f\"  {full}  ({size:.1f} MB)\")"
