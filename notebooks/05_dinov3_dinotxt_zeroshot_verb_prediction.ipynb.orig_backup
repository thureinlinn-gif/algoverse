   "source": [
    "dinov2_results_path = os.path.join(PATHS['processed'], 'nb5_dinotxt_zeroshot_results.csv')\n",
    "\n",
    "if os.path.exists(dinov2_results_path):\n",
    "    dinov2_df = pd.read_csv(dinov2_results_path)\n",
    "\n",
    "    print(\"=\" * 55)\n",
    "    print(f\"{'Model':<20} {'Top-1':>10} {'Top-5':>10}\")\n",
    "    print(\"=\" * 55)\n",
    "\n",
    "    for subset in ['training', 'validation']:\n",
    "        print(f\"\\n  Subset: {subset}\")\n",
    "        print(\"-\" * 55)\n",
    "\n",
    "        sub_v2 = dinov2_df[dinov2_df['subset'] == subset]\n",
    "        sub_v3 = results_df[results_df['subset'] == subset]\n",
    "\n",
    "        if len(sub_v2) > 0:\n",
    "            t1 = sub_v2['top1_correct'].mean()\n",
    "            t5 = sub_v2['top5_correct'].mean()\n",
    "            print(f\"  {'DINOv2 + DinoTXT':<18} {t1*100:>9.2f}% {t5*100:>9.2f}%\")\n",
    "\n",
    "        if len(sub_v3) > 0:\n",
    "            t1 = sub_v3['top1_correct'].mean()\n",
    "            t5 = sub_v3['top5_correct'].mean()\n",
    "            print(f\"  {'DINOv3 + DinoTXT':<18} {t1*100:>9.2f}% {t5*100:>9.2f}%\")\n",
    "\n",
    "    print(\"=\" * 55)\n",
    "else:\n",
    "    print(f\"DINOv2 results not found at {dinov2_results_path}\")\n",
    "    print(\"Run NB5 (DINOv2 DinoTXT) first to enable comparison.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "per-verb-header",
   "metadata": {},
   "source": [
    "## Per-verb accuracy breakdown"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "per-verb",
   "metadata": {},
   "outputs": [],
   "source": [
    "per_verb = results_df.groupby('ground_truth').agg(\n",
    "    count    = ('top1_correct', 'count'),\n",
    "    top1_acc = ('top1_correct', 'mean'),\n",
    "    top5_acc = ('top5_correct', 'mean'),\n",
    ").sort_values('count', ascending=False)\n",
    "\n",
    "print(\"Top 20 most frequent verbs (DINOv3 + DinoTXT):\")\n",
    "print(per_verb.head(20).to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "confusion-header",
   "metadata": {},
   "source": [
    "## Confusion analysis — most commonly confused verb pairs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "confusion",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Look at wrong predictions to find systematic confusions\n",
    "wrong = results_df[~results_df['top1_correct']].copy()\n",
    "confusion_pairs = wrong.groupby(['ground_truth', 'top1_pred']).size().reset_index(name='count')\n",
    "confusion_pairs = confusion_pairs.sort_values('count', ascending=False)\n",
    "\n",
    "print(f\"Total wrong predictions : {len(wrong):,}\")\n",
    "print(\"\\nTop 15 confused verb pairs (ground truth → predicted):\")\n",
    "print(confusion_pairs.head(15).to_string(index=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "save-header",
   "metadata": {},
   "source": [
    "## Save results"
   ]
  },
  {
