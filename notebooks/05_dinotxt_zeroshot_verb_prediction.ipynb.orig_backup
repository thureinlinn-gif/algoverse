   "source": [
    "import json, os\n",
    "from tqdm import tqdm  # instead of tqdm.notebook\n",
    "\n",
    "EMB_DIR     = PATHS['embeddings']\n",
    "CKPT_PATH   = \"results_checkpoint.jsonl\"  # save progress here\n",
    "\n",
    "# ── Resume from checkpoint ──────────────────────────────────────────\n",
    "done_ids = set()\n",
    "results  = []\n",
    "\n",
    "if os.path.exists(CKPT_PATH):\n",
    "    with open(CKPT_PATH) as f:\n",
    "        for line in f:\n",
    "            row = json.loads(line)\n",
    "            results.append(row)\n",
    "            done_ids.add(row['segment_id'])\n",
    "    print(f\"Resumed from checkpoint: {len(results):,} rows already done\")\n",
    "\n",
    "# ── Main loop ───────────────────────────────────────────────────────\n",
    "missing = 0\n",
    "\n",
    "with open(CKPT_PATH, \"a\") as ckpt_file:\n",
    "    for _, row in tqdm(df.iterrows(), total=len(df), desc=\"Zero-shot prediction\"):\n",
    "\n",
    "        if row['segment_id'] in done_ids:   # skip already-processed\n",
    "            continue\n",
    "\n",
    "        emb_path = os.path.join(EMB_DIR, f\"{row['segment_id']}.pt\")\n",
    "        if not os.path.exists(emb_path):\n",
    "            missing += 1\n",
    "            continue\n",
    "\n",
    "        video_emb  = torch.load(emb_path, map_location=DEVICE)\n",
    "        video_emb  = video_emb / video_emb.norm()\n",
    "\n",
    "        text_embs  = get_text_embeddings_for_segment(row['masked_caption'])\n",
    "        similarity = text_embs @ video_emb\n",
    "\n",
    "        top5_indices = similarity.topk(5).indices.tolist()\n",
    "        top1_verb    = verb_vocab[top5_indices[0]]\n",
    "        ground_truth = row['extracted_verb']\n",
    "        gt_idx       = verb_vocab.index(ground_truth) if ground_truth in verb_vocab else -1\n",
    "\n",
    "        entry = {\n",
    "            'segment_id'    : row['segment_id'],\n",
    "            'subset'        : row['subset'],\n",
    "            'ground_truth'  : ground_truth,\n",
    "            'top1_pred'     : top1_verb,\n",
    "            'top5_preds'    : [verb_vocab[i] for i in top5_indices],\n",
    "            'top1_correct'  : top1_verb == ground_truth,\n",
    "            'top5_correct'  : gt_idx in top5_indices,\n",
    "            'masked_caption': row['masked_caption'],\n",
    "        }\n",
    "\n",
    "        results.append(entry)\n",
    "        ckpt_file.write(json.dumps(entry) + \"\\n\")\n",
    "        ckpt_file.flush()   # write to disk immediately\n",
    "\n",
    "print(f\"Predicted          : {len(results):,}\")\n",
    "print(f\"Missing embeddings : {missing:,}\")"
   ]
  },
