    "import torch.nn as nn\n",
    "\n",
    "# Replace projection to match V-JEPA2 checkpoint shape (1280 → 1024)\n",
    "dinotxt.text_model.head.linear_projection = nn.Linear(1280, 1024, bias=False).to(DEVICE)\n",
    "\n",
    "# Now load the checkpoint\n",
    "ckpt = torch.load(\n",
    "    os.path.join(CKPT_DIR, 'vjepa2_dinotxt_v2_cont_epoch5.pt'),\n",
    "    map_location=DEVICE\n",
    ")\n",
    "dinotxt.text_model.head.linear_projection.load_state_dict(ckpt)\n",
    "dinotxt.eval()\n",
    "\n",
    "# Freeze everything\n",
    "for param in dinotxt.parameters():\n",
    "    param.requires_grad = False\n",
    "\n",
    "print(f\"Loaded V-JEPA2 checkpoint ✓\")\n",
    "print(f\"Projection shape: {dinotxt.text_model.head.linear_projection.weight.shape}\")"
   ]
  },
