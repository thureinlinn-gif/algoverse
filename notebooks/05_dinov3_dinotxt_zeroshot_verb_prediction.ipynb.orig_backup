    "common_segment_ids = set(common['segment_ids'])\n",
    "\n",
    "# Load DINOv2 results from checkpoint\n",
    "dinov2_results = []\n",
    "with open('/home/ubuntu/youcook2-videos/notebooks/results_checkpoint.jsonl') as f:\n",
    "    for line in f:\n",
    "        line = line.strip()\n",
    "        if line:\n",
    "            dinov2_results.append(json.loads(line))\n",
    "\n",
    "dinov2_df = pd.DataFrame(dinov2_results)\n",
    "\n",
    "# Filter to common segments\n",
    "dinov2_common = dinov2_df[dinov2_df['segment_id'].isin(common_segment_ids)]\n",
    "\n",
    "top1 = dinov2_common['top1_correct'].mean()\n",
    "top5 = dinov2_common['top5_correct'].mean()\n",
    "\n",
    "print(f\"=== DINOv2 + DinoTXT ===\")\n",
