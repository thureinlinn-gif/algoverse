  {
   "cell_type": "code",
   "execution_count": null,
   "id": "zeroshot",
   "metadata": {},
   "outputs": [],
   "source": [
    "results = []\n",
    "missing = 0\n",
    "\n",
    "for _, row in tqdm(df.iterrows(), total=len(df), desc=\"Zero-shot prediction\"):\n",
    "    emb_path = os.path.join(DINOV3_EMB_DIR, f\"{row['segment_id']}.pt\")\n",
    "\n",
    "    if not os.path.exists(emb_path):\n",
    "        missing += 1\n",
    "        continue\n",
    "\n",
    "    # Load precomputed DINOv3 video embedding\n",
    "    video_emb = torch.load(emb_path, map_location=DEVICE)  # (1280,)\n",
    "    video_emb = video_emb / video_emb.norm()                # L2 normalise\n",
    "\n",
    "    # Encode all verbs in this caption's context\n",
    "    text_embs = get_text_embeddings_for_segment(row['masked_caption'])  # (n_verbs, 1280)\n",
    "\n",
    "    # Cosine similarity → (n_verbs,)\n",
    "    similarity   = text_embs @ video_emb\n",
    "    top5_indices = similarity.topk(5).indices.tolist()\n",
    "    top1_verb    = verb_vocab[top5_indices[0]]\n",
    "    ground_truth = row['extracted_verb']\n",
    "    gt_idx       = verb_vocab.index(ground_truth) if ground_truth in verb_vocab else -1\n",
    "\n",
    "    results.append({\n",
    "        'segment_id'    : row['segment_id'],\n",
    "        'subset'        : row['subset'],\n",
    "        'ground_truth'  : ground_truth,\n",
    "        'top1_pred'     : top1_verb,\n",
    "        'top5_preds'    : [verb_vocab[i] for i in top5_indices],\n",
    "        'top1_correct'  : top1_verb == ground_truth,\n",
    "        'top5_correct'  : gt_idx in top5_indices,\n",
    "        'masked_caption': row['masked_caption'],\n",
    "    })\n",
    "\n",
    "print(f\"Predicted          : {len(results):,}\")\n",
    "print(f\"Missing embeddings : {missing:,}\")"
   ]
  },
