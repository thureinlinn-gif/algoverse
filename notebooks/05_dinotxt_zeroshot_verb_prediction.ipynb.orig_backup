ister_state_dict_pre_hook', 'requires_grad_', 'set_extra_state', 'set_submodule', 'share_memory', 'state_dict', 'to', 'to_empty', 'token_embedding', 'train', 'training', 'type', 'vocab_size', 'xpu', 'zero_grad']\n"
     ]
    }
   ],
   "source": [
    "print(dir(dinotxt.text_model.backbone))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Context length from positional_embedding: 77\n",
      "Test caption          : [MASK] and chop the garlic\n",
      "Text embeddings shape : torch.Size([282, 2048])  (expected: (282, SHARED_DIM))\n",
      "L2 norm               : 1.0000  (expected: ~1.0)\n"
     ]
    }
   ],
   "source": [
    "CONTEXT_LENGTH = dinotxt.text_model.backbone.positional_embedding.shape[0]\n",
    "print(f\"Context length from positional_embedding: {CONTEXT_LENGTH}\")\n",
    "\n",
    "@torch.no_grad()\n",
    "def get_text_embeddings_for_segment(masked_caption: str) -> torch.Tensor:\n",
    "    \"\"\"\n",
    "    Given a masked caption like '[MASK] the onions into small pieces',\n",
    "    replace [MASK] with every verb in vocab and encode all candidates.\n",
    "    Returns tensor of shape (n_verbs, SHARED_DIM), L2-normalised.\n",
    "    \"\"\"\n",
    "    caption_context = masked_caption.replace('[MASK]', '{}')\n",
    "    verb_texts      = [caption_context.format(v) for v in verb_vocab]\n",
    "\n",
    "    # tokenize in one batch\n",
    "    tokens        = tokenizer.tokenize(verb_texts).to(DEVICE)\n",
    "    text_features = dinotxt.encode_text(tokens)           # (n_verbs, SHARED_DIM)\n",
    "    text_features = text_features / text_features.norm(dim=-1, keepdim=True)\n",
    "    return text_features\n",
    "\n",
    "\n",
    "# Quick sanity check\n",
    "test_caption = df['masked_caption'].iloc[0]\n",
    "test_emb     = get_text_embeddings_for_segment(test_caption)\n",
    "print(f\"Test caption          : {test_caption}\")\n",
    "print(f\"Text embeddings shape : {test_emb.shape}  (expected: ({n_verbs}, SHARED_DIM))\")\n",
    "print(f\"L2 norm               : {test_emb.norm(dim=-1).mean():.4f}  (expected: ~1.0)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Zero-shot verb prediction\n",
    "\n",
    "For each segment:\n",
    "1. Load the precomputed video embedding from NB4\n",
    "2. Encode all verb candidates in the caption context\n",
    "3. Pick the verb with the highest cosine similarity to the video embedding\n",
    "4. Record Top-1 and Top-5 correctness"
   ]
  },
