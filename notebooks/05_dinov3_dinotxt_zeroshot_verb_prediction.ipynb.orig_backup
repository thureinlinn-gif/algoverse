   "source": [
    "import torch.nn.functional as F\n",
    "\n",
    "# ── Load best V-JEPA2 checkpoint ──────────────────────────────────────────────\n",
    "ckpt = torch.load(\n",
    "    os.path.join(CKPT_DIR, 'vjepa2_dinotxt_v2_cont_epoch5.pt'),\n",
    "    map_location=DEVICE\n",
    ")\n",
    "dinotxt.text_model.head.linear_projection.load_state_dict(ckpt)\n",
    "dinotxt.eval()\n",
    "print(\"Loaded best V-JEPA2 checkpoint\\n\")\n",
    "\n",
    "# ── Use the same common segments identified by DINOv2 and DINOv3 ──────────────\n",
    "common_segment_ids = common_ids  # from the comparison cell above\n",
    "\n",
    "# Filter df_val to only common segments\n",
    "df_common = df_val[df_val['segment_id'].isin(common_segment_ids)].reset_index(drop=True)\n",
    "print(f\"Common segments to evaluate : {len(df_common):,}\")\n",
    "\n",
    "VJEPA2_EMB_DIR = os.path.join(PATHS['embeddings'], 'vjepa2_dinotxt')\n",
    "\n",
    "vjepa2_results = []\n",
    "missing = 0\n",
    "\n",
    "with torch.no_grad():\n",
    "    for _, row in tqdm(df_common.iterrows(), total=len(df_common), desc=\"V-JEPA2 prediction\"):\n",
    "        emb_path = os.path.join(VJEPA2_EMB_DIR, f\"{row['segment_id']}.pt\")\n",
    "        if not os.path.exists(emb_path):\n",
    "            missing += 1\n",
    "            continue\n",
    "\n",
    "        video_emb = torch.load(emb_path, map_location=DEVICE)\n",
    "        video_emb = F.normalize(video_emb.unsqueeze(0), dim=-1)\n",
    "\n",
    "        CHUNK = 64\n",
    "        all_embs = []\n",
    "        for i in range(0, len(verb_vocab), CHUNK):\n",
    "            tokens = tokenizer.tokenize(verb_vocab[i:i+CHUNK]).to(DEVICE)\n",
    "            embs   = dinotxt.encode_text(tokens, normalize=True)\n",
    "            all_embs.append(embs)\n",
    "        verb_embs = torch.cat(all_embs, dim=0)  # (282, 1024)\n",
    "\n",
    "        sim          = (dinotxt.logit_scale.exp() * video_emb @ verb_embs.T).squeeze(0)\n",
    "        top5_indices = sim.topk(5).indices.tolist()\n",
    "        top1_verb    = verb_vocab[top5_indices[0]]\n",
    "        top5_verbs   = [verb_vocab[i] for i in top5_indices]\n",
    "        gt_verb      = row['extracted_verb']\n",
    "        gt_idx       = label2id.get(gt_verb, -1)\n",
    "\n",
    "        vjepa2_results.append({\n",
    "            'segment_id'  : row['segment_id'],\n",
    "            'subset'      : row['subset'],\n",
    "            'ground_truth': gt_verb,\n",
    "            'top1_pred'   : top1_verb,\n",
    "            'top5_preds'  : top5_verbs,\n",
    "            'top1_correct': top1_verb == gt_verb,\n",
    "            'top5_correct': gt_idx in top5_indices,\n",
    "            'masked_caption': row['masked_caption'],\n",
    "        })\n",
    "\n",
    "vjepa2_df = pd.DataFrame(vjepa2_results)\n",
    "\n",
    "# ── Three-way comparison on common segments ───────────────────────────────────\n",
    "print(f\"\\n=== Three-way comparison on {len(common_segment_ids)} common segments ===\\n\")\n",
    "print(f\"{'Model':<25} {'Top-1':>10} {'Top-5':>10} {'N':>6}\")\n",
    "print(\"=\" * 58)\n",
    "\n",
    "# DINOv2\n",
    "sub_v2 = dinov2_common[dinov2_common['subset'] == 'validation']\n",
    "if len(sub_v2) > 0:\n",
    "    print(f\"  {'DINOv2 + DinoTXT':<23} {sub_v2['top1_correct'].mean()*100:>9.2f}% {sub_v2['top5_correct'].mean()*100:>9.2f}%  {len(sub_v2):>5}\")\n",
    "\n",
    "# DINOv3\n",
    "sub_v3 = dinov3_common[dinov3_common['subset'] == 'validation']\n",
    "if len(sub_v3) > 0:\n",
    "    print(f\"  {'DINOv3 + DinoTXT':<23} {sub_v3['top1_correct'].mean()*100:>9.2f}% {sub_v3['top5_correct'].mean()*100:>9.2f}%  {len(sub_v3):>5}\")\n",
    "\n",
    "# V-JEPA2\n",
    "sub_vj = vjepa2_df[vjepa2_df['subset'] == 'validation']\n",
    "if len(sub_vj) > 0:\n",
    "    print(f\"  {'V-JEPA2 + DinoTXT':<23} {sub_vj['top1_correct'].mean()*100:>9.2f}% {sub_vj['top5_correct'].mean()*100:>9.2f}%  {len(sub_vj):>5}\")\n",
    "\n",
    "print(\"=\" * 58)\n",
    "print(f\"  {'Random baseline':<23} {100/len(verb_vocab):>9.2f}% {500/len(verb_vocab):>9.2f}%\")\n",
    "print(\"=\" * 58)\n",
    "print(f\"\\nMissing V-JEPA2 embeddings : {missing}\")\n",
    "\n",
    "# ── Per-segment comparison for first 10 common segments ───────────────────────\n",
    "print(f\"\\n=== Per-segment comparison (first 10) ===\\n\")\n",
    "for seg_id in list(common_segment_ids)[:10]:\n",
    "    row_vj = vjepa2_df[vjepa2_df['segment_id'] == seg_id]\n",
    "    row_v2 = dinov2_df[dinov2_df['segment_id'] == seg_id]\n",
    "    row_v3 = results_df[results_df['segment_id'] == seg_id]\n",
    "\n",
    "    if row_vj.empty:\n",
    "        continue\n",
    "\n",
    "    gt   = row_vj.iloc[0]['ground_truth']\n",
    "    cap  = row_vj.iloc[0]['masked_caption']\n",
    "\n",
    "    print(f\"Segment : {seg_id}\")\n",
    "    print(f\"Caption : {cap}\")\n",
    "    print(f\"GT verb : {gt}\")\n",
    "\n",
    "    if not row_v2.empty:\n",
    "        r = row_v2.iloc[0]\n",
    "        print(f\"  DINOv2  Top-1: {r['top1_pred']:<12} {'✓' if r['top1_correct'] else '✗'}  Top-5: {r['top5_preds']}\")\n",
    "    if not row_v3.empty:\n",
    "        r = row_v3.iloc[0]\n",
    "        print(f\"  DINOv3  Top-1: {r['top1_pred']:<12} {'✓' if r['top1_correct'] else '✗'}  Top-5: {r['top5_preds']}\")\n",
    "    if not row_vj.empty:\n",
    "        r = row_vj.iloc[0]\n",
    "        print(f\"  V-JEPA2 Top-1: {r['top1_pred']:<12} {'✓' if r['top1_correct'] else '✗'}  Top-5: {r['top5_preds']}\")\n",
    "    print()"
   ]
  },
